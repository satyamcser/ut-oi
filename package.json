{
  "name": "ut-oi",
  "private": true,
  "version": "1.0.0",
  "description": "Út ơi! — a tiny, private, two-player 2D Hanoi adventure.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools@15.35.0 emulators:exec --only firestore --project demo-ut-oi \"npx vitest run --config vitest.rules.config.ts\""
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
